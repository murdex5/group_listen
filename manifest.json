{
  "manifest_version": 3,
  "name": "Group Listen",
  "description": "An Open Source chrome extension where you can listen to YouTube or Spotify together.",
  "version": "1.0.0",

  "permissions": ["storage"],
  "host_permissions": ["https://www/youtube.com/*"],

  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "Group Listen"
  },

  "background": {
    "service_worker": ["https://youtube.com/*"],
    "tyoe": "module"
  },

  "content_scripts": [
    {
      "matches": [
        "https://www.youtube.com/*",
        "https://www.music.youtube.com/*"
      ],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
